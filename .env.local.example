# Used to build absolute links in invite emails
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (local: run `npx supabase start` and copy from `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Field-level encryption for Aadhaar/passport numbers (32-byte key, base64).
# Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Transactional email (invites, temp passwords)
RESEND_API_KEY=
EMAIL_FROM=

# Local testing only: every newly provisioned account (Centre Admin, Coach,
# Medical, Parent) gets this password instead of a random emailed one.
# NEVER set this in a deployed environment. Leave blank outside local dev.
DEV_DEFAULT_PASSWORD=

# One-time Super Admin seed script (see scripts/seed-super-admin.ts)
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_NAME=
