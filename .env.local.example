# Used to build absolute links in invite emails
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (local: run `npx supabase start` and copy from `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase secret API key (sb_secret_..., Dashboard > Project Settings > API
# Keys). Server-only, never expose to the browser. Used ONLY by the session
# refresh in src/lib/supabase/middleware.ts so Supabase Auth sees the real
# client IP via Sb-Forwarded-For (otherwise every user shares the server's IP
# for auth rate limits). Needs a trusted client IP: VERCEL=1 (automatic on
# Vercel) or TRUSTED_PROXY_HOPS below; without one it falls back to the anon
# key and production logs a warning. Optional: blank = anon key as before.
SUPABASE_SECRET_KEY=

# Field-level encryption for Aadhaar/passport numbers (32-byte key, base64).
# Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# Cloudflare R2 (S3-compatible). R2_BUCKET_NAME must have public access
# enabled (r2.dev or a custom domain) for R2_PUBLIC_URL to work — that
# bucket is used for centre logos.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
# Optional: a second bucket with public access left OFF, for player/staff
# documents and injury reports. Without this, those still work — they're
# stored in R2_BUCKET_NAME alongside logos, "private" only because their
# key is an unguessable UUID, not because the bucket enforces it. Set this
# for a real access boundary instead of relying on that.
R2_PRIVATE_BUCKET_NAME=

# Transactional email (invites, temp passwords, email-change notices).
# REQUIRED in production: src/lib/env.ts refuses to boot with
# NODE_ENV=production unless RESEND_API_KEY and EMAIL_FROM are both set —
# an emailed temporary password is the only way a provisioned account
# learns its credentials. EMAIL_FROM must be an address on a domain
# verified in Resend, either "noreply@example.com" or the named form
# "Impetus <noreply@example.com>". See docs/DEPLOYMENT.md section 3.
RESEND_API_KEY=
EMAIL_FROM=
# Signing secret for the Resend webhook (Dashboard > Webhooks > your
# endpoint > Signing Secret). Verified in src/app/api/webhooks/resend.
# Optional: without it email still sends, only delivery status tracking
# in Email Analytics stops updating.
RESEND_WEBHOOK_SECRET=

# Route Mobile WhatsApp Business API (new-player onboarding message only —
# see src/lib/whatsapp/send.ts). Auth is username/password -> a 1-hour JWT,
# used for the template-send call; the API host itself is fixed (not
# configurable), only these credentials are secret.
ROUTE_MOBILE_USERNAME=
ROUTE_MOBILE_PASSWORD=

# Local testing only: every newly provisioned account (Centre Admin, Coach,
# Medical, Parent) gets this password instead of a random emailed one.
# NEVER set this in a deployed environment. Leave blank outside local dev.
DEV_DEFAULT_PASSWORD=

# One-time Super Admin seed script (see scripts/seed-super-admin.ts)
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_NAME=

# Error tracking (optional — everything no-ops without these, see
# sentry.server.config.ts / sentry.edge.config.ts / instrumentation-client.ts).
# SENTRY_DSN and NEXT_PUBLIC_SENTRY_DSN are typically the same value — the
# NEXT_PUBLIC_ one ships in the browser bundle, which is expected: Sentry
# DSNs aren't secret. SENTRY_ORG/PROJECT/AUTH_TOKEN are build-time only, for
# uploading source maps, and every one of these is unrelated to whether
# error capture itself works at runtime.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Distributed rate limiting (login, password reset, uploads) via Upstash
# Redis REST. REQUIRED in production (src/lib/env.ts refuses to boot without
# them); leave blank locally to use the in-memory fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Trusted proxy for per-IP rate limiting and Supabase Sb-Forwarded-For (see
# SUPABASE_SECRET_KEY). On Vercel nothing is needed (VERCEL=1 is automatic).
# Elsewhere, set the number of proxies you operate in front of the app (e.g. 1
# for a single load balancer) so the client IP is read from the right of
# X-Forwarded-For. Leave blank locally / if untrusted: IP limits are then
# skipped and the secret-key path falls back to the anon key.
TRUSTED_PROXY_HOPS=
