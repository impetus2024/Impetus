# Used to build absolute links in invite emails
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (local: run `npx supabase start` and copy from `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Field-level encryption for Aadhaar/passport numbers (32-byte key, base64).
# Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# Cloudflare R2 (S3-compatible). R2_BUCKET_NAME must have public access
# enabled (r2.dev or a custom domain) for R2_PUBLIC_URL to work — that
# bucket is used for centre logos.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
# Optional: a second bucket with public access left OFF, for player/staff
# documents and injury reports. Without this, those still work — they're
# stored in R2_BUCKET_NAME alongside logos, "private" only because their
# key is an unguessable UUID, not because the bucket enforces it. Set this
# for a real access boundary instead of relying on that.
R2_PRIVATE_BUCKET_NAME=

# Transactional email (invites, temp passwords)
RESEND_API_KEY=
EMAIL_FROM=

# Local testing only: every newly provisioned account (Centre Admin, Coach,
# Medical, Parent) gets this password instead of a random emailed one.
# NEVER set this in a deployed environment. Leave blank outside local dev.
DEV_DEFAULT_PASSWORD=

# One-time Super Admin seed script (see scripts/seed-super-admin.ts)
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_NAME=

# Error tracking (optional — everything no-ops without these, see
# sentry.server.config.ts / sentry.edge.config.ts / instrumentation-client.ts).
# SENTRY_DSN and NEXT_PUBLIC_SENTRY_DSN are typically the same value — the
# NEXT_PUBLIC_ one ships in the browser bundle, which is expected: Sentry
# DSNs aren't secret. SENTRY_ORG/PROJECT/AUTH_TOKEN are build-time only, for
# uploading source maps, and every one of these is unrelated to whether
# error capture itself works at runtime.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
