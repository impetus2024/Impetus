{
  "name": "impetus-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed:super-admin": "node --env-file=.env.local -r tsx/cjs scripts/seed-super-admin.ts",
    "seed:test-accounts": "node --env-file=.env.local -r tsx/cjs scripts/seed-test-accounts.ts",
    "seed:mock-data": "node --env-file=.env.local -r tsx/cjs scripts/seed-mock-data.ts",
    "backfill:registration-payments": "node --env-file=.env.local -r tsx/cjs scripts/backfill-registration-payments.ts",
    "test:e2e": "playwright test",
    "db:dump-schema": "supabase db dump --local --schema public -f schema.sql",
    "db:push": "node -r tsx/cjs scripts/lib/supabase-guard.ts db push",
    "db:reset:linked": "node -r tsx/cjs scripts/lib/supabase-guard.ts db reset --linked",
    "supabase:link": "node -r tsx/cjs scripts/lib/supabase-guard.ts link"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.5.7",
    "@react-pdf/renderer": "^4.6.0",
    "@sentry/nextjs": "^10.69.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.83.0",
    "resend": "^6.18.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.15.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
